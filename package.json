{
  "name": "openstreamalert",
  "productName": "OpenStreamAlert",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "dist/server/desktop/main.js",
  "description": "Beautiful, private Twitch chat overlays for OBS.",
  "license": "MIT",
  "homepage": "https://github.com/ericflo/openstreamalert#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ericflo/openstreamalert.git"
  },
  "bugs": {
    "url": "https://github.com/ericflo/openstreamalert/issues"
  },
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "build:demo": "node scripts/build-public-demo.mjs",
    "build:desktop": "npm run build && node scripts/write-desktop-config.mjs",
    "start": "node dist/server/server/index.js",
    "check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:demo": "playwright test --config playwright.demo.config.ts",
    "test:twitch-cli": "vitest run --config vitest.twitch-cli.config.ts",
    "desktop": "npm run build:desktop && electron-forge start",
    "package:win": "npm run build:desktop && electron-forge package --platform win32 --arch x64",
    "make:win": "npm run build:desktop && electron-forge make --platform win32 --arch x64",
    "preview:demo": "node scripts/serve-public-demo.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.8",
    "electron-squirrel-startup": "1.0.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron/fuses": "2.1.3",
    "@electron/windows-sign": "2.1.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.4",
    "electron": "44.7.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "tar": "7.5.22",
    "tmp": "0.2.7"
  },
  "config": {
    "forge": "./forge.config.cjs"
  }
}

# Public URL registered as your Twitch application's OAuth redirect base.
APP_URL=http://localhost:5173
PORT=5173
# Native Node and Compose host publishing bind locally by default. Change only
# when a trusted proxy or firewall requires access through another interface.
BIND_ADDRESS=127.0.0.1

# Create an app at https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Comma-separated Twitch logins allowed to connect. Required for configured
# production deployments; in local development, an empty list lets the first
# connected account claim the instance.
TWITCH_ALLOWED_USERS=

# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Persisted SQLite data. The directory is ignored by Git.
DATABASE_PATH=./data/openstreamalert.sqlite

# Optional deployment identifier exposed in diagnostics (for example a tag or SHA).
BUILD_VERSION=development
